# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local อยู่ใน .gitignore แล้ว ไม่ถูก commit)

# Supabase → Project Settings → Database → Connection string → แท็บ Transaction pooler
DATABASE_URL=

# Finnhub → หน้า Dashboard หลังสมัคร
FINNHUB_API_KEY=

# ป้องกันไม่ให้คนอื่นยิง cron endpoint เอง (Vercel ใส่ค่านี้ให้อัตโนมัติตอน deploy)
CRON_SECRET=
