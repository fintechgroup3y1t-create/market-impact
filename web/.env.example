# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local อยู่ใน .gitignore แล้ว ไม่ถูก commit)

# Supabase → ปุ่ม Connect → แท็บ ORM → Drizzle → DATABASE_URL
DATABASE_URL=

# Tiingo → หน้า Account → API หลังสมัคร
TIINGO_API_KEY=

# FRED (Federal Reserve Economic Data) → fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# EIA (Energy Information Administration) → eia.gov/opendata/register.php
EIA_API_KEY=

# Marketaux (ข่าวการเงิน) → marketaux.com หน้า Dashboard หลังสมัคร
MARKETAUX_API_KEY=

# ป้องกันไม่ให้คนอื่นยิง cron endpoint เอง (Vercel ใส่ค่านี้ให้อัตโนมัติตอน deploy)
CRON_SECRET=

# รหัสผ่านสำหรับ /api/admin/* (ตั้งค่าเริ่มต้นฐานข้อมูลครั้งแรก) ตั้งเป็นค่าสุ่มยาว ๆ
ADMIN_SECRET=
